# Copy this file to .env and fill in the real value.
# Never commit .env.

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=qwen/qwen3.6-27b

# Optional attribution headers supported by OpenRouter
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=SecureMail RAG
SECUREMAIL_SESSION_SECRET=securemail-local-demo-session-secret

# App
APP_ENV=development
LOG_LEVEL=INFO

# Database placeholders
DATABASE_URL=postgresql://securemail:securemail@localhost:5432/securemail

# Feature flags: advanced features OFF by default
ENABLE_QUERY_REWRITE=false
ENABLE_HYDE=false
ENABLE_CRAG=false
ENABLE_SELF_RAG=false
ENABLE_TEXT2SQL=false
ENABLE_CACHE=false
